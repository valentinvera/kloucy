{
  "name": "@kloucy/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "ELECTRON_DISABLE_SANDBOX=1 expo start",
    "dev": "ELECTRON_DISABLE_SANDBOX=1 expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prod": "expo export",
    "web": "expo start --web",
    "eas": "bun --env-file=.env node_modules/.bin/eas",
    "eas:init": "bun run eas -- init --account valenvera-team --non-interactive",
    "eas:config": "bun run eas -- config --non-interactive",
    "eas:update:configure": "bun run eas -- update:configure --non-interactive",
    "eas:build": "bun run eas -- build --profile production",
    "eas:build:android": "bun run eas -- build --platform android --profile production",
    "eas:build:ios": "bun run eas -- build --platform ios --profile production",
    "eas:update": "bun run eas -- update",
    "eas:update:preview": "bun run eas -- update --channel preview --environment preview",
    "eas:update:production": "bun run eas -- update --channel production --environment production",
    "generate": "uniwind generate-artifacts --css ./styles/globals.css --dts ./uniwind-env.d.ts && node scripts/generate-expo-env.mjs",
    "check-types": "bun run generate && tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kloucy/env": "workspace:*",
    "@kloucy/tokens": "workspace:*",
    "@kloucy/trpc": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.8",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-network": "~57.0.0",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "^57.0.5",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.11",
    "expo-web-browser": "~57.0.0",
    "heroui-native": "^1.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "catalog:",
    "uniwind": "^1.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kloucy/ts-config": "workspace:*",
    "@types/node": "^26.0.1",
    "@types/react": "catalog:",
    "eas-cli": "^21.4.0",
    "typescript": "catalog:"
  }
}
