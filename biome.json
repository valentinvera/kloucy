{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!skills-lock.json",
      "!**/node_modules",
      "!bun.lock",
      "!**/dist",
      "!**/.turbo",
      "!**/.zed",
      "!**/.agents",
      "!**/.codex",
      "!**/routeTree.gen.ts",
      "!**/.expo",
      "!**/drizzle"
    ]
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "info"
      },
      "suspicious": {
        "noUndeclaredEnvVars": "error"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ]
}
